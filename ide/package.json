{
  "name": "peps-ide",
  "private": true,
  "version": "1.6.0",
  "packageManager": "pnpm@11.18.0",
  "type": "module",
  "scripts": {
    "wasm:build": "wasm-pack build .. --target web --out-dir ide/src/wasm",
    "wasm:build:dev": "wasm-pack build .. --target web --out-dir ide/src/wasm --dev",
    "dev": "pnpm run wasm:build:dev && vite",
    "build": "pnpm run wasm:build && vite build",
    "test": "pnpm run wasm:build:dev && vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@vitejs/plugin-react": "^4.3.4",
    "emojilib": "^4.0.2",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "jsdom": "^25.0.1",
    "vitest": "^4.1.7",
    "wasm-pack": "0.15.0"
  }
}
